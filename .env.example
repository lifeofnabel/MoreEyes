# Kopieren nach .env und ausfuellen. .env wird NIE committet.

# Kamera (RTSP-Zugang nach Werksreset/Test ermittelt)
CAM_MAIN_URL=rtsp://USER:PASS@KAMERA-IP:554/live/main
CAM_SUB_URL=rtsp://USER:PASS@KAMERA-IP:554/live/sub

# Adresse, unter der ANDERE GERAETE im LAN diesen Rechner erreichen (fuer WebRTC).
# Anpassen, wenn sich das Netzwerk aendert (Hotspot -> Heim-WLAN -> KI-Server).
LAN_HOST_IP=192.168.1.50

# Admin-Login der Weboberflaeche (Sprint 2)
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGEME
# Zufaelliger, langer String zum Signieren der Session-Cookies - generieren, nicht raten.
SESSION_SECRET=CHANGEME
